[Unit]
Description=Piano LED Visualizer
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/Piano-LED-Visualizer/
ExecStart=/home/Piano-LED-Visualizer/.venv/bin/python /home/Piano-LED-Visualizer/visualizer.py
Restart=always
Type=simple
User=root
Group=root
UMask=0077
# The runtime never needs first-login secrets. GPIO/DMA still require root.
InaccessiblePaths=-/var/lib/plv-bootstrap

[Install]
WantedBy=multi-user.target
